---
layout: base.njk
navSection: notes
---
<div class="notebook-layout">
  <aside class="notebook-sidebar" aria-label="TOEIC notebook">
    <details class="notebook-menu" open><summary>TOEIC · Contents</summary>
      <nav aria-label="TOEIC sections">
        <a href="/notes/toeic/"{% if vocabularyOverview %} aria-current="page"{% endif %}>TOEIC overview</a>
        <a href="/notes/toeic/vocabulary/a/"{% if (page.url == "/notes/toeic/vocabulary/a/" or page.url == "/notes/toeic/vocabulary/a/index.html") %} aria-current="page"{% endif %}>Vocabulary · A</a>
        <p class="eyebrow-small">Reading practice</p>
        <a href="/notes/toeic/reading/"{% if readingOverview %} aria-current="page"{% endif %}>10-test practice log</a>
        <a class="notebook-subsection-link" href="/notes/toeic/reading/test-1/"{% if readingTestOne %} aria-current="page"{% endif %}>Test 1 · Review notes</a>
      </nav>
    </details>
  </aside>
  <article class="solution-article notebook-article">
    <a class="solution-back" href="/notes/english/">← English notes</a>
    <div class="eyebrow">English · TOEIC study notes</div>
    <h1>{{ title }}</h1>
    <p class="lead">{{ summary }}</p>
    <p class="notebook-updated">Last updated <time datetime="{{ updated | dateISO }}">{{ updated | dateLabel }}</time></p>
    <div class="vocabulary-content">{{ content | safe }}</div>
    <nav class="notebook-pagination" aria-label="Collection navigation">
      {% if vocabularyOverview %}<a href="/notes/toeic/vocabulary/a/">A · abreast–attendee →</a>{% elif readingTestOne %}<a href="/notes/toeic/reading/">← Reading practice log</a>{% elif readingOverview %}<a href="/notes/toeic/">← TOEIC overview</a><a href="/notes/toeic/reading/test-1/">Test 1 · Review notes →</a>{% else %}<a href="/notes/toeic/">← TOEIC overview</a>{% endif %}
    </nav>
  </article>
</div>
